msgid "CORE_ADMIN_RENAME_PAGE_SENTENCE"
msgstr "Ändert den Titel der Seite {page} im Entwurf; ihre ID bleibt gleich."

msgid "CORE_ADMIN_LOG_LEVEL_EFFECT"
msgstr "Ändert, wie viel diese Instanz in die Logs schreibt; ein erhöhter Pegel kehrt nach einer Weile zum Standard zurück."

msgid "CORE_ADMIN_SET"
msgstr "Setzen"

msgid "CORE_ADMIN_RESTART_INSTANCE"
msgstr "Instanz neu starten"

msgid "CORE_ADMIN_RESTART_INSTANCE_EFFECT"
msgstr "Stoppt und startet nur diese Instanz; ihr Feld auf dem Spiegel behält einige Sekunden das letzte Bild."
