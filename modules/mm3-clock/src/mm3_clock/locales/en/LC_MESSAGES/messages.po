msgstr "Degrees, -180 to 180"

msgid "MOON_0"
msgstr "New moon"

msgid "MOON_1"
msgstr "Waxing crescent"

msgid "MOON_2"
msgstr "First quarter"

msgid "MOON_3"
msgstr "Waxing gibbous"

msgid "MOON_4"
msgstr "Full moon"

msgid "MOON_5"
msgstr "Waning gibbous"

msgid "MOON_6"
msgstr "Last quarter"

msgid "MOON_7"
msgstr "Waning crescent"

msgid "SUNRISE"
msgstr "Sunrise"

msgid "SUNSET"
msgstr "Sunset"

msgid "DAY_LENGTH"
msgstr "Day length"

msgid "DURATION"
msgstr "{hours} h {minutes} min"

msgid "MOONRISE"
msgstr "Moonrise"

msgid "MOONSET"
msgstr "Moonset"

