msgstr "ISO 8601 week number"

msgid "CFG_TIMEZONE"
msgstr "Time zone"

msgid "CFG_TIMEZONE_HELP"
msgstr "IANA name replacing the mirror's time zone for this clock"

msgid "CFG_ZONES"
msgstr "Other time zones"

msgid "CFG_ZONES_HELP"
msgstr "Up to 4 extra time zones under the clock"

msgid "CFG_ZONE_TIMEZONE"
msgstr "Time zone"

msgid "CFG_ZONE_TIMEZONE_HELP"
msgstr "IANA name, for example America/New_York"

msgid "CFG_ZONE_LABEL"
msgstr "Label"

