msgid "CORE_ADMIN_SYSTEM_SEEN_RESTART_ENGINE"
msgstr "Die Engine wurde neu gestartet."

msgid "CORE_ADMIN_SYSTEM_SEEN_RESTART_KIOSK"
msgstr "Der Kiosk ist wieder verbunden."

msgid "CORE_ADMIN_SYSTEM_SEEN_REBOOT"
msgstr "Das System wurde neu gestartet."

msgid "CORE_ADMIN_SYSTEM_UNSEEN"
msgstr "„{action}“ wurde vor 120 s angefordert; die Wirkung wurde nicht gesehen."

msgid "CORE_ADMIN_RESTORE"
msgstr "Wiederherstellen"

msgid "CORE_ADMIN_RESTORE_ELLIPSIS"
msgstr "Wiederherstellen…"

msgid "CORE_ADMIN_RESTORE_EFFECT"
msgstr "Die Wiederherstellung erzeugt Version {created}, gleich Version {version}, und die Engine wendet sie im laufenden Betrieb an. Die aktuelle Konfiguration bleibt im Verlauf."

msgid "CORE_ADMIN_RESTORE_SECTION_EFFECT"
msgstr "Die Wiederherstellung erzeugt Version {created} mit {section} wie in Version {version}; die übrigen Abschnitte bleiben unverändert."

msgid "CORE_ADMIN_RESTORE_SECTION_ROW"
msgstr "Ändert nur den gewählten Abschnitt; die übrigen bleiben unverändert."

msgid "CORE_ADMIN_OPEN_IN_EDITOR_EFFECT"
msgstr "Lädt diese Version als Entwurf. Es wird nichts geschrieben, bis Sie speichern."

msgid "CORE_ADMIN_OPEN"
msgstr "Öffnen"

msgid "CORE_ADMIN_ALREADY_CURRENT"
msgstr "Das ist bereits die aktuelle Version."

msgid "CORE_ADMIN_NO_SECTIONS_IN_VERSION"
msgstr "Diese Version hat keinen Abschnitt geändert."

msgid "CORE_ADMIN_WORKING"
msgstr "Eine andere Aktion läuft."

msgid "CORE_ADMIN_REPLACE_DRAFT_TITLE"
msgstr "Den Entwurf durch Version {version} ersetzen?"

msgid "CORE_ADMIN_REPLACE_DRAFT_ACTION"
msgstr "Entwurf ersetzen"

msgid "CORE_ADMIN_REVIEW_SENTENCE"
msgstr "Abschnitte, die sich gegenüber der aktuellen Version ändern: {count}. Es wurde nichts geschrieben; mit Speichern werden sie übernommen."

msgid "CORE_ADMIN_ADD_MODULE_SENTENCE"
msgstr "Fügt dem Entwurf auf Seite {page} eine Instanz hinzu, in {file}. Der Schritt lässt sich rückgängig machen; gespeichert wird erst beim Speichern."

msgid "CORE_ADMIN_ADD_MODULE_SENTENCE_NOPAGE"
msgstr "Fügt dem Entwurf eine Instanz hinzu, in {file}. Der Schritt lässt sich rückgängig machen; gespeichert wird erst beim Speichern."

msgid "CORE_ADMIN_NEW_PAGE_SENTENCE"
