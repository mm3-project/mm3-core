#!/usr/bin/python3 -IS
"""systemd generator of the MM3 share mounts (CORE-407, Core spec 0.57, §9.7 Media service).

mm3-install.sh installs this file, as root, into
/usr/lib/systemd/system-generators/. systemd runs it at boot and on every
reload. It reads the mounts the installer wants from
/var/lib/mm3-install/mounts/shares.json ([{name, type, host, path}]), checks
every entry again and writes, into the directory systemd gives it, for each one

    var-lib-mm3-media-shares-<name>.mount
    var-lib-mm3-media-shares-<name>.automount

(the names systemd requires for the mount point
/var/lib/mm3/media/shares/<name>), with the automount wanted by
remote-fs.target. The installer itself never writes a unit file.

This program runs as root, so it trusts nothing in that file: the file must be
a regular file owned by mm3-install, not writable by others and small; an
entry with a bad name, type, host or path is skipped with a message. It uses
only the standard library, never imports MM3 code and always exits 0, so a bad
file never stops the boot.

Implements:
    CORE-407: Core spec 0.57, §9.7 Media service.
"""

import json
import os
import pwd
import re
import stat
import sys

STATE = "/var/lib/mm3-install/mounts"
WANTED = STATE + "/shares.json"
SHARES = "/var/lib/mm3/media/shares"
PREFIX = "var-lib-mm3-media-shares-"
OWNER = "mm3-install"
MAX_FILE = 256 * 1024
MAX_SHARES = 64

NAME = re.compile(r"^[a-z][a-z0-9_]{0,31}$")
HOST = re.compile(r"^[A-Za-z0-9]([A-Za-z0-9.-]{0,252}[A-Za-z0-9])?$")

COMMON = "ro,nosuid,nodev,noexec,_netdev"
SMB = "uid=mm3,gid=mm3,file_mode=0444,dir_mode=0555"
NFS = "soft,timeo=100,retrans=3"


def say(text):
    sys.stderr.write("mm3-media-mounts: " + text + "\n")


def path_ok(path):
    """A share path that can stand in a unit file (CORE-407)."""
    return (
        isinstance(path, str)
        and 0 < len(path) <= 1024
        and path == path.strip(" ")
        and "\\" not in path
        and not any(ord(c) < 32 or ord(c) == 127 for c in path)
    )


def read_wanted():
    try:
        fd = os.open(WANTED, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except FileNotFoundError:
        return []
    except OSError as exc:
        say("cannot open " + WANTED + ": " + exc.strerror)
        return []
    try:
        st = os.fstat(fd)
        try:
            owner = pwd.getpwnam(OWNER).pw_uid
        except KeyError:
            say("no user " + OWNER)
            return []
        if (
            not stat.S_ISREG(st.st_mode)
            or st.st_uid != owner
            or st.st_mode & 0o022
            or st.st_size > MAX_FILE
        ):
            say(WANTED + " is not a small file owned by " + OWNER + " and writable only by it")
            return []
        data = os.read(fd, MAX_FILE + 1)
    finally:
        os.close(fd)
    try:
        entries = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        say(WANTED + " is not JSON")
        return []
    if not isinstance(entries, list):
        say(WANTED + " is not a list")
        return []
    return entries[:MAX_SHARES]


def check(entry):
    """The entry as (name, type, host, path), or None with a message."""
    if not isinstance(entry, dict):
        say("skipping an entry that is not an object")
        return None
    name, kind = entry.get("name"), entry.get("type")
    host, path = entry.get("host"), entry.get("path")
    if not isinstance(name, str) or not NAME.match(name):
        say("skipping a share with a bad name")
        return None
    if kind not in ("smb", "nfs"):
        say("skipping " + name + ": the type must be smb or nfs")
        return None
    if not isinstance(host, str) or not HOST.match(host):
        say("skipping " + name + ": bad host")
        return None
    if not path_ok(path):
        say("skipping " + name + ": bad path")
        return None
    return name, kind, host, path


def escape(value):
    """Escape a value for a unit file: % starts a specifier."""
    return value.replace("%", "%%")


def units(name, kind, host, path):
    where = SHARES + "/" + name
    if kind == "smb":
        what = "//" + host + "/" + path.lstrip("/")
        cred = STATE + "/" + name + ".cred"
        options = COMMON + "," + SMB + ",credentials=" + cred
        fstype = "cifs"
    else:
        what = host + ":" + (path if path.startswith("/") else "/" + path)
        options = COMMON + "," + NFS
        fstype = "nfs"
    head = (
        "# Made by mm3-media-mounts from " + WANTED + "; do not edit.\n"
        "[Unit]\nDescription=MM3 media share " + name + "\n"
    )
    mount = (
        head
        + "[Mount]\nWhat=" + escape(what) + "\nWhere=" + where + "\nType=" + fstype
        + "\nOptions=" + escape(options) + "\nTimeoutSec=10s\n"
    )
    automount = head + "[Automount]\nWhere=" + where + "\nTimeoutIdleSec=600\n"
    return mount, automount


def write(directory, name, text):
    path = os.path.join(directory, name)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
    try:
        os.write(fd, text.encode("utf-8"))
    finally:
        os.close(fd)


def main(argv):
    if len(argv) < 2:
        say("usage: mm3-media-mounts <normal-dir> [<early-dir> <late-dir>]")
        return 0
    out = argv[1]
    wants = os.path.join(out, "remote-fs.target.wants")
    for entry in read_wanted():
        found = check(entry)
        if found is None:
            continue
        name = found[0]
        mount, automount = units(*found)
        try:
            write(out, PREFIX + name + ".mount", mount)
            write(out, PREFIX + name + ".automount", automount)
            os.makedirs(wants, mode=0o755, exist_ok=True)
            link = os.path.join(wants, PREFIX + name + ".automount")
            if not os.path.lexists(link):
                os.symlink("../" + PREFIX + name + ".automount", link)
        except OSError as exc:
            say("cannot write the units of " + name + ": " + exc.strerror)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
