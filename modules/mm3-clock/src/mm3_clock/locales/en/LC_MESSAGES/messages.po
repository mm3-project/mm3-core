msgid "HEADER"
msgstr "Clock"

msgid "CFG_DISPLAY"
msgstr "Display"

msgid "CFG_DISPLAY_HELP"
msgstr "Digital, analog or both"

msgid "CFG_SHOW_SECONDS"
msgstr "Show seconds"

msgid "CFG_SHOW_SECONDS_HELP"
msgstr "Show seconds and the second hand"

msgid "CFG_TIME_FORMAT"
msgstr "Time format"

msgid "CFG_TIME_FORMAT_HELP"
msgstr "locale follows the language; 12 or 24 hours"

msgid "CFG_SHOW_DATE"
msgstr "Show date"

msgid "CFG_SHOW_DATE_HELP"
msgstr "Show the date under the time"

msgid "CFG_DATE_STYLE"
msgstr "Date style"

msgid "CFG_DATE_STYLE_HELP"
msgstr "short, medium, long or full"

msgid "CFG_SHOW_WEEK"
msgstr "Show week number"

